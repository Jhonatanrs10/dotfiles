# ==========================================
# GERAL & SISTEMA
# ==========================================

# reset sxhkd e bspwm
super + shift + r
	bspc wm -r; pkill -USR1 -x sxhkd

# terminal emulator
super + Return
	alacritty

# program launcher (Branco e Preto)
super + shift + d
	source "$HOME/.config/bspwm/colors" && dmenu_run -nb "$color1" -nf "$color2" -sb "$color2" -sf "$color1"

# Rofi
super + d
	rofi -show drun

# gerenciador de arquivos e navegador
super + x
	thunar

super + c
	chromium

super + b
    alacritty -e bluetui

super + n
	alacritty -e nmtui

super + j 
	alacritty -e jrs

super + m
	alacritty -e cmus

super + a
	alacritty -e wiremix --tab output

# xcolor
super + z
	xcolor -s

# Dispara o MPV com o link da área de transferência e mostra uma prévia do link na notificação
super + v
    source ~/.config/jrs/jrs-mpv.sh && mpv_paste

# dotfiles
super + period
	code ~/.dotfiles

super + ctrl + d
	~/.config/jrs/jrs-exec-discord.sh

super + g
	chromium --app=https://gemini.google.com/app

super + y
	chromium --app=https://youtube.com/

super + t
	chromium --app=https://twitch.tv/

super + s
	chromium --app=http://localhost:8384/

# ==========================================
# GERENCIAMENTO DE JANELAS E FOCO
# ==========================================

# close and kill
{super + q,alt + F4}
	bspc node -c

# alternar entre layout tiled e monocle
super + w
	bspc desktop -l next

# Alternar especificamente entre Tiled e Floating
super + {shift + space,button2}
	bspc node -t ~floating

# Alternar especificamente entre Tiled e Fullscreen
super + f
	bspc node -t ~fullscreen

# Alternar especificamente para Tiled
super + e
	bspc node -t tiled

# focar nó na direção dada
super + {_,shift + }{Left,Down,Up,Right}
	bspc node -{f,s} {west,south,north,east}

# focar próxima/anterior janela no desktop atual
super + Tab
	bspc node -f {next}.local.!hidden.window

# focar último nó/desktop
alt + Tab
	bspc {node,desktop} -f last

# focar ou enviar para o desktop dado
super + {_,shift + }{1-9,0}
	bspc {desktop -f,node -d} '^{1-9,10}'

# expandir janela movendo um lado para fora
super + alt + {Left,Down,Up,Right}
	bspc node -z {left -20 0 || bspc node -z right -20 0, \
        bottom 0 20 || bspc node -z top 0 20,\
        top 0 -20 || bspc node -z bottom 0 -20,\
        right 20 0 || bspc node -z left 20 0}

# ==========================================
# WIDGETS DE NOTIFICAÇÃO (DUNST COM NERD FONTS)
# ==========================================

# Hora e Data completa (Ícone de relógio/calendário Nerd Font)
super + ctrl + t
	~/.config/dunst/scripts/time.sh

# Previsão do Tempo rápida (Ícone de clima Nerd Font)
super + ctrl + w
	~/.config/dunst/scripts/weather.sh

# Status Energia
super + ctrl + e
	~/.config/dunst/scripts/power-status.sh

# Power Profile
super + ctrl + p
	source ~/.config/jrs/jrs-power-profiles.sh && profile-roll

# Status de Conexão (Wi-Fi/Ethernet + IP)
super + ctrl + n
	~/.config/dunst/scripts/connection.sh

# ==========================================
# ÁUDIO E BRILHO (COM ÍCONES NERD FONTS)
# ==========================================

# Aumentar Volume
super + ctrl + Up 
	~/.config/dunst/scripts/volume-up.sh

XF86AudioRaiseVolume
	~/.config/dunst/scripts/volume-up.sh

# Diminuir Volume
super + ctrl + Down
	~/.config/dunst/scripts/volume-down.sh

XF86AudioLowerVolume
	~/.config/dunst/scripts/volume-down.sh

# Mutar / Desmutar Áudio
super + ctrl + m
	~/.config/dunst/scripts/volume-mute.sh

XF86AudioMute
	~/.config/dunst/scripts/volume-mute.sh

# Mutar / Desmutar Microfone
XF86AudioMicMute
	~/.config/dunst/scripts/mic-mute.sh

super + ctrl + Right
	~/.config/dunst/scripts/brightness-up.sh

super + ctrl + Left
	~/.config/dunst/scripts/brightness-down.sh

XF86MonBrightnessUp
	~/.config/dunst/scripts/brightness-up.sh

XF86MonBrightnessDown
	~/.config/dunst/scripts/brightness-down.sh

# ==========================================
# SESSÃO
# ==========================================

super + shift + e
	bspc quit

super + l 
	i3lock -c 000000 && sleep 1

super + ctrl + 9
	reboot

super + ctrl + 0
	poweroff

# ==========================================
# CAPTURA DE TELA (PRINT SCREEN)
# ==========================================

super + Print
	mkdir -p ~/Pictures/PrtSc && scrot ~/Pictures/PrtSc/Screenshot_%Y-%m-%d_%H-%M-%S.png

Print
	mkdir -p ~/Pictures/PrtSc && scrot -f -s ~/Pictures/PrtSc/Cutshot_%Y-%m-%d_%H-%M-%S.png