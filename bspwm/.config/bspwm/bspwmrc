#! /bin/sh

source "$HOME/.config/bspwm/colors"

pgrep -x sxhkd > /dev/null || sxhkd &

bspc monitor -d 1 2 3 4 5

bspc config border_width	2
bspc config window_gap		0
bspc config top_padding		0
bspc config bottom_padding 	0
bspc config left_padding 	0
bspc config right_padding 	0

bspc config automatic_scheme longest_side
bspc config initial_polarity second_child
bspc config removal_adjustment true

bspc config split_ratio          0.5
bspc config borderless_monocle   false
bspc config gapless_monocle      false

bspc config normal_border_color "$color2"
bspc config focused_border_color "$color1"
bspc config focus_follows_pointer true

#AutoStart
xsetroot -cursor_name left_ptr &
/usr/bin/dbus-update-activation-environment --all
/usr/bin/dunst &
/usr/bin/polkit-gnome/polkit-gnome-authentucation-agent-1 &
/usr/bin/gnome-keyring-daemon --start --components=pkcs11,secrets,ssh,gpg &
xset -b &
kdeconnect-indicator &
syncthing --no-browser &
nwg-look -a &